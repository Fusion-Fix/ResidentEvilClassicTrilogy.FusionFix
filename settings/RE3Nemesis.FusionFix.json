{
  "format": "asi-settings",
  "version": "1.0",
  "plugin": {
    "name": "Fusion Fix",
    "priority": 100,
    "games": [
      {
        "name": "Resident Evil 3: Nemesis",
        "launcher": [
          "4249120_Launcher.exe"
        ],
        "exe": [
          {
            "path": "english/ResidentEvil3.exe",
            "label": "ResidentEvil3 (english)"
          },
          {
            "path": "english/RE3_MERCE.exe",
            "label": "RE3_MERCE (english)"
          },
          {
            "path": "french/ResidentEvil3.exe",
            "label": "ResidentEvil3 (french)"
          },
          {
            "path": "french/RE3_MERCE.exe",
            "label": "RE3_MERCE (french)"
          },
          {
            "path": "german/ResidentEvil3.exe",
            "label": "ResidentEvil3 (german)"
          },
          {
            "path": "german/RE3_MERCE.exe",
            "label": "RE3_MERCE (german)"
          },
          {
            "path": "italian/ResidentEvil3.exe",
            "label": "ResidentEvil3 (italian)"
          },
          {
            "path": "italian/RE3_MERCE.exe",
            "label": "RE3_MERCE (italian)"
          },
          {
            "path": "spanish/ResidentEvil3.exe",
            "label": "ResidentEvil3 (spanish)"
          },
          {
            "path": "spanish/RE3_MERCE.exe",
            "label": "RE3_MERCE (spanish)"
          },
          {
            "path": "japanese/Bio3_PC.exe",
            "label": "Bio3_PC (japanese)"
          },
          {
            "path": "japanese/Bio3_PC_Mercenaries.exe",
            "label": "Bio3_PC_Mercenaries (japanese)"
          },
          "ResidentEvil3.exe",
          "RE3_MERCE.exe"
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "display",
      "title": "@page.display",
      "section": "display"
    },
    {
      "id": "controls",
      "title": "@page.controls",
      "section": "controls"
    },
    {
      "id": "game",
      "title": "@page.game",
      "section": "other"
    },
    {
      "id": "system",
      "title": "@page.system",
      "section": "compatibility"
    }
  ],
  "settings": [
    {
      "id": "MAIN.PanAndScan",
      "type": "bool",
      "default": 1,
      "label": "@widescreen",
      "description": "@widescreen.description",
      "page": "display",
      "control": [
        "switch",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.MaxAspectRatio",
      "type": "string",
      "default": "16:9",
      "suggestions": [
        {
          "value": "4:3"
        },
        {
          "value": "16:10"
        },
        {
          "value": "16:9"
        },
        {
          "value": "21:9"
        },
        {
          "value": "32:9"
        }
      ],
      "label": "@aspectlimit",
      "description": "@aspectlimit.description",
      "page": "display",
      "control": [
        "cycler",
        "text"
      ]
    },
    {
      "id": "MAIN.WobbleFix",
      "type": "bool",
      "default": 1,
      "label": "@wobble",
      "description": "@wobble.description",
      "page": "display",
      "control": [
        "switch",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.AlternateControls",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 0,
          "label": "@original"
        },
        {
          "value": 1,
          "label": "@alternate"
        }
      ],
      "label": "@controltype",
      "description": "@controltype.description",
      "page": "controls",
      "control": [
        "cycler",
        "segmented"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.HDControls",
      "type": "choice",
      "default": 1,
      "choices": [
        {
          "value": 1,
          "label": "@remaster"
        },
        {
          "value": 0,
          "label": "@original"
        }
      ],
      "label": "@bindings",
      "description": "@bindings.description",
      "page": "controls",
      "control": [
        "cycler",
        "segmented"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.DefaultPace",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@walk"
        },
        {
          "value": 1,
          "label": "@run"
        }
      ],
      "label": "@defaultpace",
      "description": "@defaultpace.description",
      "page": "controls",
      "control": [
        "cycler",
        "segmented"
      ]
    },
    {
      "id": "MAIN.ShiftBehavior",
      "type": "choice",
      "default": 0,
      "choices": [
        {
          "value": 0,
          "label": "@hold"
        },
        {
          "value": 1,
          "label": "@toggle"
        }
      ],
      "label": "@shiftbehavior",
      "description": "@shiftbehavior.description",
      "page": "controls",
      "control": [
        "cycler",
        "segmented"
      ]
    },
    {
      "id": "MAIN.MouseSteering",
      "type": "bool",
      "default": 1,
      "label": "@mousesteering",
      "description": "@mousesteering.description",
      "page": "controls",
      "control": [
        "switch",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.MouseSensitivity",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "decimals": 2,
      "label": "@mousesensitivity",
      "description": "@mousesensitivity.description",
      "page": "controls",
      "control": [
        "slider"
      ],
      "enabledIf": {
        "setting": "MAIN.MouseSteering",
        "equals": 1
      }
    },
    {
      "id": "MAIN.SkipIntro",
      "type": "bool",
      "default": 1,
      "label": "@skipintro",
      "description": "@skipintro.description",
      "page": "game",
      "control": [
        "switch",
        "cycler"
      ],
      "apply": "restart",
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.SkipDoor",
      "type": "bool",
      "default": 1,
      "label": "@skipdoors",
      "description": "@skipdoors.description",
      "page": "game",
      "control": [
        "switch",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 1,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.FastLoad",
      "type": "bool",
      "default": 0,
      "label": "@fastload",
      "description": "@fastload.description",
      "page": "game",
      "control": [
        "switch",
        "cycler"
      ],
      "presets": {
        "vanilla": 0,
        "recommended": 0,
        "enhanced": 1
      }
    },
    {
      "id": "MAIN.AutoLoad",
      "type": "bool",
      "default": 0,
      "label": "@autoload",
      "description": "@autoload.description",
      "page": "game",
      "control": [
        "switch",
        "cycler"
      ],
      "apply": "restart"
    },
    {
      "id": "MAIN.LoadSlot",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 30,
      "step": 1,
      "special": [
        {
          "value": 0,
          "label": "@latest"
        }
      ],
      "label": "@loadslot",
      "description": "@loadslot.description",
      "page": "game",
      "control": [
        "cycler",
        "slider"
      ]
    },
    {
      "id": "MAIN.AutoPush",
      "type": "bool",
      "default": 1,
      "label": "@autopush",
